# ---- required ----
NODE_ENV=development
PORT=8787
# Supabase: Project Settings → Database → Connection string (URI). Use the pooler URL on serverless hosts.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
DATABASE_SSL=true
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
# The website's origin(s), comma-separated. Cookies and CORS are limited to these.
WEB_ORIGIN=http://localhost:5173
TRUST_PROXY=1
PUBLIC_API_URL=http://localhost:8787

# ---- image & video storage: supabase | cloudinary | local (dev only) ----
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- online payments (off until you are ready) ----
PAYMENTS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
